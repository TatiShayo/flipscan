# ==============================================================================
# FLIPSCAN SUPABASE / EDGE FUNCTIONS ENVIRONMENT SECRETS
# ==============================================================================
# Configure these with `supabase secrets set KEY=VALUE` or in Supabase Dashboard.

# Supabase Admin / Service Role Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key

# Anthropic Claude API Key (Vision identification)
